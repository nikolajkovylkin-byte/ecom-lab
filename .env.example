# Необязательно. Если укажешь VITE_FORMSPREE_ENDPOINT — заявки будут уходить
# через Formspree (formspree.io), без serverless-функции и Telegram-бота.
# Если оставить пустым — форма сама уйдёт на /api/submit-application (Telegram-бот),
# см. инструкцию в api/submit-application.js и README.md.
VITE_FORMSPREE_ENDPOINT=

# Для serverless-функций (api/*.js) — задаются в Vercel: Settings → Environment
# Variables (для локальной разработки через `vercel dev` можно вписать и сюда).
# ADMIN_TOKEN — придумай любую длинную случайную строку, это пароль для
# страницы модерации отзывов /admin/reviews.
ADMIN_TOKEN=
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID — см. README, раздел про заявки и отзывы.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
